{
  "name": "fivem-server-manager",
  "productName": "FiveM Server Manager",
  "version": "0.1.0",
  "description": "Run, manage and duplicate multiple FiveM servers on one Windows machine.",
  "main": "./out/main/index.js",
  "author": "FiveM Server Manager contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mas-inx/fivem-server-manager.git"
  },
  "homepage": "https://github.com/Mas-inx/fivem-server-manager",
  "bugs": {
    "url": "https://github.com/Mas-inx/fivem-server-manager/issues"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/build-icons.mjs",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "dist:dir": "electron-vite build && electron-builder --win --dir --config electron-builder.yml",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "electron-updater": "^6.8.11",
    "extract-zip": "^2.0.1",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  }
}
